# Postgres connection. For Neon, paste the connection string from the Neon console
# (keep ?sslmode=require on the end). Local example below.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5001/perstrive

# First admin account (created by `npm run db:seed`)
ADMIN_EMAIL=admin@perstrive.com
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=Perstrive Admin

# Meta Marketing API (used by the sync job; leave blank until you connect it)
META_ACCESS_TOKEN=
META_API_VERSION=v23.0
# Days back to pull on each sync
META_SYNC_DAYS=7

# Shared secret for calling /api/sync/meta from a cron job
CRON_SECRET=
