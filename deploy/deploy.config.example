# Copy to deploy/deploy.config and fill in. deploy.config is not uploaded to the server.

# VPS IP address (or hostname) and SSH login. The user needs sudo, or use root.
VPS_HOST=
VPS_USER=root
SSH_PORT=22

DOMAIN=base44.blendfoldmedia.com
APP_DIR=/var/www/perstrive-dashboard

# Optional: email for Let's Encrypt expiry notices.
CERTBOT_EMAIL=
